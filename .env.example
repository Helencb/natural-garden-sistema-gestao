# ============================================
# Natural Garden - Variáveis de Ambiente (exemplo)
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" de verdade no Git.
# ============================================

# ---------- Backend (Spring Boot) ----------
SERVER_PORT=8080

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=natural_garden_db
DB_USER=root
DB_PASSWORD=changeme

# Autenticação JWT
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria
JWT_EXPIRATION_MS=86400000

# ---------- Frontend (React) ----------
REACT_APP_API_BASE_URL=http://localhost:8080/api

# ---------- Deploy (produção) ----------
# Preencher apenas no ambiente de produção (Render/Railway/Vercel/Netlify)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# REACT_APP_API_BASE_URL=
